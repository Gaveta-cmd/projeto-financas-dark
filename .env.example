# Copie este arquivo para .env e ajuste as senhas antes de subir o banco.
# O docker-compose.yml e a API Spring Boot leem estas variáveis.

DB_NAME=vibefinance
DB_USER=vibefinance
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_PORT=3306

# Dias até o login expirar
SESSION_DAYS=30

# Deixe "true" até a família se cadastrar; depois mude para "false".
SIGNUP_ENABLED=true
